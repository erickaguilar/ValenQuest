{
  "name": "valenquest",
  "version": "2.2.0",
  "description": "KidsLearn-WASM: Plataforma interactiva en Rust WebAssembly y Vanilla JS para el aprendizaje infantil en Lumiria",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "build:all": "./scripts/build.sh",
    "version:bump": "node scripts/bump-version.js",
    "version:check": "node scripts/bump-version.js --check",
    "test": "cargo test",
    "test:campaign": "node scripts/smoke-campaign.mjs",
    "test:content": "node scripts/smoke-content.mjs",
    "test:contract": "node scripts/check-terminal-tonto.mjs",
    "test:profile": "node scripts/smoke-profile-storage.mjs",
    "test:e2e": "playwright test",
    "serve": "python3 -m http.server 8090 --directory www",
    "serve:dist": "python3 -m http.server 8090 --directory dist"
  },
  "keywords": [
    "wasm",
    "rust",
    "edtech",
    "kids-learning",
    "local-first",
    "pwa"
  ],
  "author": "Erick Aguilar",
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "purgecss": "^8.0.0"
  }
}
